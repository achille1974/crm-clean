function StaffCard({
  nome,
  tel,
  wa,
}: {
  nome: string;
  tel: string;
  wa: string;
}) {
  return (
    <div className="rounded-[24px] border border-slate-100 bg-slate-50 p-4 md:p-5">
      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p className="text-lg font-bold text-slate-950">{nome}</p>
          <p className="text-sm text-slate-500">Consulente PHONESIA</p>
        </div>

        <div className="flex flex-col gap-3 sm:flex-row">
          <a
            href={`tel:${tel}`}
            className="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800"
          >
            📞 {formatPhone(tel)}
          </a>

          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            className="inline-flex items-center justify-center rounded-2xl bg-green-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-green-700"
          >
            💬 WhatsApp
          </a>
        </div>
      </div>
    </div>
  );
}

function formatPhone(phone: string) {
  return phone
    .replace("+39", "+39 ")
    .replace(/(\+39)\s?(\d{3})(\d{3})(\d{4})/, "$1 $2 $3 $4");
}
