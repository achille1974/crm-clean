    "test:qr": "node --test scripts/phonesia/qr-security.test.mjs scripts/phonesia/qr-outbox.test.mjs scripts/phonesia/qr-browser-storage.test.mjs scripts/phonesia/qr-health.test.mjs scripts/phonesia/qr-monitor-state.test.mjs",
